<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <Title>KamiYomu Action Agent Core</Title>
        <Description>A event-driven action system for KamiYomu that enables extensible automation through triggered actions at key application moments.</Description>
        <Authors>KamiYomu</Authors>
        <Owners>KamiYomu</Owners>
        <PackageProjectUrl>https://github.com/KamiYomu/KamiYomu.ActionAgents.Core</PackageProjectUrl>
        <RepositoryUrl>https://github.com/KamiYomu/KamiYomu.ActionAgents.Core</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>kamiyomu;kamiyomu-action-core;action-system</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Copyright>Copyright © KamiYomu. All rights reserved.</Copyright>
        <PackageIcon>logo.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <IncludeSymbols>True</IncludeSymbols>
        <IncludeSource>True</IncludeSource>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    </ItemGroup>


    <ItemGroup>
        <None Include="Resources\logo.png" Pack="true" PackagePath="/" />
        <None Include="..\..\README.md" Link="README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

    <Import Project="KamiYomu.ActionAgents.Core.props" />
</Project>
